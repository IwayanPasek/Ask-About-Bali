# Salin file ini menjadi .env di root project, lalu isi nilainya.
# JANGAN pernah commit file .env yang berisi nilai asli.

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=900

# --- Google Programmable Search Engine (Web & Image Search) ---
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_SEARCH_MAX_RESULTS=6
GOOGLE_SEARCH_TIMEOUT_SECONDS=8
GOOGLE_SEARCH_COUNTRY=id

# --- Google Maps (Places API) ---
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_TIMEOUT_SECONDS=8
GOOGLE_MAPS_MAX_RESULTS=5
GOOGLE_MAPS_LANGUAGE=id
GOOGLE_MAPS_REGION=ID

# --- TiDB Cloud (catatan penggunaan anonim) ---
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=
# Sertifikat CA TiDB Cloud untuk koneksi TLS.
TIDB_CA_CERT_PATH=backend/certs/ca.pem
# Alternatif: URL SQLAlchemy lengkap, menang atas variabel TIDB_* di atas.
DATABASE_URL=

# --- Salt untuk hash session id browser (untuk usage log anonim) ---
# Boleh dikosongkan: backend memakai salt acak per-proses sebagai gantinya.
SESSION_HASH_SALT=
